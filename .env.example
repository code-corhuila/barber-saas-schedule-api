# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Empty DATABASE_URL: in-memory repositories (no database needed to try the HTTP contract).
DATABASE_URL=jdbc:postgresql://localhost:5432/barbersaas
DATABASE_USER=schedule_app
DATABASE_PASSWORD=
# SPKI PEM public key, one line with \n escapes. barber-saas-infra/scripts/dev-keys.sh generates a development one.
JWT_PUBLIC_KEY=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# The other domains' APIs (DEC-SCHED-03). Empty APPOINTMENT_API_URL: availability does not subtract bookings.
BARBERSHOP_API_URL=http://localhost:8081
APPOINTMENT_API_URL=
